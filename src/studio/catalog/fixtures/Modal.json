        {
          "id": "open_label",
          "component": "Text",
          "text": { "path": "/openLabel" },
          "variant": "body"
        },
        {
          "id": "body",
          "component": "Text",
          "text": { "path": "/body" },
          "variant": "body"
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "main",
